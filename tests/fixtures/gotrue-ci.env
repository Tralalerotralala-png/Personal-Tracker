# Synthetic CI-only Supabase Auth issuer. No production endpoints or credentials.
API_EXTERNAL_URL=http://127.0.0.1:9999
PORT=9999
GOTRUE_API_HOST=0.0.0.0
GOTRUE_SITE_URL=http://127.0.0.1:9999
GOTRUE_JWT_SECRET=tracker_http_only_test_secret_2026_at_least_32_chars
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_DB_DRIVER=postgres
DB_NAMESPACE=auth
DATABASE_URL=postgres://tracker_test:test_only@127.0.0.1:5432/tracker_test?sslmode=disable
GOTRUE_DB_DATABASE_URL=postgres://tracker_test:test_only@127.0.0.1:5432/tracker_test?sslmode=disable
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_LOG_LEVEL=error
